# Copy this file to .env and fill in your key. .env is git-ignored.

# --- Option A: OpenAI (default) ---
LLM_API_KEY=your-openai-key-here
LLM_MODEL=gpt-4o-mini

# --- Option B: Google Gemini (free tier) via its OpenAI-compatible endpoint ---
# LLM_API_KEY=your-gemini-key-from-ai-studio
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Context window management (optional, defaults shown) ---
# Invalid values fall back to defaults with a warning. Rules: KEEP_RECENT <= MAX_CONTEXT_MESSAGES, and SUMMARIZE_AFTER > KEEP_RECENT.
# Max messages sent to the model on each request (hard truncation window)
MAX_CONTEXT_MESSAGES=10
# When stored history exceeds this, older messages are folded into a running summary
SUMMARIZE_AFTER=16
# How many of the newest messages stay verbatim after summarising
KEEP_RECENT=8

# --- Reliability (optional) ---
REQUEST_TIMEOUT_SECONDS=30
